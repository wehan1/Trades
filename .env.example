# Copy to .env and fill in. .env is git-ignored; keys never leave the backend.

# --- Agent desk (TradingAgents on Claude) ---------------------------------
ANTHROPIC_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-5-5
TRADINGAGENTS_QUICK_THINK_LLM=claude-sonnet-5
# Optional data keys TradingAgents uses
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Jev guardrail ---------------------------------------------------------
# Either key works. OpenRouter is used when both are set.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Defaults: jev-1.13 on OpenRouter, jev-latest on TypeSafe directly.
JEV_MODEL=
# TradingAgents also uses Jev to screen Reddit/StockTwits posts when
# TYPESAFE_API_KEY is set. To route that through OpenRouter instead, set
# TYPESAFE_API_KEY to your OpenRouter key and uncomment:
# TYPESAFE_BASE_URL=https://openrouter.ai/api

# --- Alpaca (paper only; the live endpoint is not configurable) ------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Off by default: approvals are recorded but no order is sent.
PAPER_EXECUTION=false

# --- Rules -----------------------------------------------------------------
MAX_POSITION_PCT=5
MAX_DAILY_LOSS_PCT=2
DEFAULT_SIZE_PCT=3
ALLOW_SHORT=false
BLOCK_THRESHOLD=0.5
PROPOSAL_MAX_AGE_MIN=60
# Semicolon-separated. Jev flags reasoning that relies on none of these.
ALLOWED_SETUPS=pullback within an established trend;breakout from a defined range on rising volume;fundamental or news thesis citing specific reported figures or filings;post-earnings drift after a reported surprise
