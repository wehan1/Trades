# ===========================================================================
#  Your keys go here.
#  1. Copy this file:   cp .env.example .env
#  2. Paste each key after its "=" (no quotes, no spaces).
#  .env is git-ignored: it never gets committed or pushed. Never paste keys
#  into this file (.env.example), a chat, or an issue.
# ===========================================================================

# --- Claude (Opus) for the agent desk -------------------------------------
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-5-5
TRADINGAGENTS_QUICK_THINK_LLM=claude-sonnet-5

# --- Jev (TypeSafe) through OpenRouter ------------------------------------
# openrouter.ai -> Keys. Used for the guardrail's three questions.
OPENROUTER_API_KEY=v1-4d3f69e9fd3eabc45491fe07cff6c766757e34066dfe2d5a30d354741893f34d
# Or a key straight from TypeSafe; OpenRouter is used when both are set.
TYPESAFE_API_KEY=
# Defaults: jev-1.13 on OpenRouter, jev-latest on TypeSafe directly.
JEV_MODEL=
# TradingAgents also uses Jev to screen Reddit/StockTwits posts, but reads only
# TYPESAFE_API_KEY. To run that screening on your OpenRouter key, put the same
# OpenRouter key in TYPESAFE_API_KEY above and uncomment:
# TYPESAFE_BASE_URL=https://openrouter.ai/api

# --- Alpaca paper trading ---------------------------------------------------
# app.alpaca.markets -> switch to Paper Trading -> API Keys. Paper keys only:
# the code talks to the paper endpoint and has no setting for live.
ALPACA_API_KEY_ID=PKWJDJQTHZHJFBT6E3F3XXUMV2
ALPACA_API_SECRET_KEY=G1yUdeZaKrme8h6w9czQJKzdAmdn1Jice2sa756bPAsz
# Off by default: approvals are recorded but no order is sent.
PAPER_EXECUTION=false

# --- Optional data keys TradingAgents uses ---------------------------------
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Crypto rules -------------------------------------------------------------
CRYPTO_UNIVERSE=BTC/USD,ETH/USD,SOL/USD
MAX_CRYPTO_POSITION_PCT=10
MAX_CRYPTO_EXPOSURE_PCT=30
# A stop-out may cost at most this much of the account; bigger sizes are cut.
MAX_RISK_PER_TRADE_PCT=1
# Stop-limit sells fill down to this far below the stop price.
CRYPTO_STOP_LIMIT_BUFFER_PCT=1.5
# Semicolon-separated. Jev flags crypto reasoning that relies on none of these.
CRYPTO_ALLOWED_SETUPS=pullback to the rising 20- or 50-day average while price holds above its 200-day average;daily close breaking out of a range of at least two weeks on rising volume;flow or news thesis citing specific reported figures such as ETF net flows, exchange reserves or a dated protocol upgrade

# --- Rules for every asset ------------------------------------------------
MAX_DAILY_LOSS_PCT=2
BLOCK_THRESHOLD=0.5
PROPOSAL_MAX_AGE_MIN=60
DEFAULT_SIZE_PCT=3

# --- Stock rules (unused if you only trade crypto) -------------------------
MAX_POSITION_PCT=5
ALLOW_SHORT=false
ALLOWED_SETUPS=pullback within an established trend;breakout from a defined range on rising volume;fundamental or news thesis citing specific reported figures or filings;post-earnings drift after a reported surprise
